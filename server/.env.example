# Server settings carry the IMAGE_EDIT_ prefix; see server/README.md for the full list.

# Key that signs result-image links. Leave empty for a random key per start (fine for one
# process). Set 32 or more characters, the same on every instance, when running several.
# The server does not read this file itself: export the values into the environment, or run
# uvicorn with --env-file server/.env.
IMAGE_EDIT_RESULT_URL_SECRET=

# Disposable email domains (one per line), read at startup; a missing file stops the server.
IMAGE_EDIT_DISPOSABLE_DOMAINS_FILE=./seed/abuse/disposable_domains.txt

# How many proxies in front of the server append to X-Forwarded-For (0 to 5). Use 1 behind one
# AWS load balancer. With 0 the header is ignored. Sign-up limits are counted per this address.
IMAGE_EDIT_TRUSTED_PROXY_HOPS=0
